{
  "name": "@prakash1935/devorax",
  "version": "0.1.0",
  "description": "Developer infrastructure toolkit connecting common pieces needed for modern applications.",
  "keywords": [
    "utility",
    "infrastructure",
    "toolkit",
    "typescript",
    "saas",
    "ai",
    "validation",
    "security"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/devorax.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/devorax/issues"
  },
  "homepage": "https://github.com/your-org/devorax#readme",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./security": {
      "import": {
        "types": "./dist/security/index.d.ts",
        "default": "./dist/security/index.js"
      },
      "require": {
        "types": "./dist/security/index.d.cts",
        "default": "./dist/security/index.cjs"
      }
    },
    "./api": {
      "import": {
        "types": "./dist/api/index.d.ts",
        "default": "./dist/api/index.js"
      },
      "require": {
        "types": "./dist/api/index.d.cts",
        "default": "./dist/api/index.cjs"
      }
    },
    "./ai": {
      "import": {
        "types": "./dist/ai/index.d.ts",
        "default": "./dist/ai/index.js"
      },
      "require": {
        "types": "./dist/ai/index.d.cts",
        "default": "./dist/ai/index.cjs"
      }
    },
    "./india": {
      "import": {
        "types": "./dist/india/index.d.ts",
        "default": "./dist/india/index.js"
      },
      "require": {
        "types": "./dist/india/index.d.cts",
        "default": "./dist/india/index.cjs"
      }
    },
    "./validation": {
      "import": {
        "types": "./dist/validation/index.d.ts",
        "default": "./dist/validation/index.js"
      },
      "require": {
        "types": "./dist/validation/index.d.cts",
        "default": "./dist/validation/index.cjs"
      }
    },
    "./async": {
      "import": {
        "types": "./dist/async/index.d.ts",
        "default": "./dist/async/index.js"
      },
      "require": {
        "types": "./dist/async/index.d.cts",
        "default": "./dist/async/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
